{
  "manifest_version": 3,
  "name": "Carnet TOEIC",
  "version": "2.3",
  "description": "Enregistre un test blanc (questions, réponses, hésitations, audio), transcrit l'audio et prépare un dossier d'analyse compact.",
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "downloads", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_title": "Carnet TOEIC" },
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
